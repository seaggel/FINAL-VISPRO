<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrossPlatformApp.Views.AdminWindow"
        Title="Admin"
        Width="1180" Height="820"
        WindowStartupLocation="CenterScreen">
  <Border Padding="20" Background="#F8FAFC">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="4">
          <TextBlock Text="Admin" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
          <TextBlock Text="Mahasiswa, konselor, sesi." Foreground="#475569" />
        </StackPanel>

        <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="16" Padding="12" VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <TextBlock x:Name="SessionText" Text="Session: -" Foreground="#0F172A" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh" Click="Refresh_Click" />
              <Button Content="Logout" Click="Logout_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,16">
        <Border Background="#EFF6FF" CornerRadius="14" Padding="14" Margin="0,0,12,0">
          <StackPanel Spacing="4">
            <TextBlock Text="Mahasiswa" Foreground="#334155" />
            <TextBlock x:Name="MahasiswaCountText" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="14" Padding="14" Margin="0,0,12,0">
          <StackPanel Spacing="4">
            <TextBlock Text="Konselor" Foreground="#334155" />
            <TextBlock x:Name="KonselorCountText" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="14" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="Sesi" Foreground="#334155" />
            <TextBlock x:Name="SesiCountText" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
          </StackPanel>
        </Border>
      </Grid>

      <TabControl Grid.Row="2">
        <TabItem Header="Mahasiswa">
          <Grid ColumnDefinitions="2*,3*" Margin="0,14,0,0">
            <Border Background="#FFFFFF" CornerRadius="16" Padding="12" Margin="0,0,12,0">
              <StackPanel Spacing="10">
                <TextBlock Text="Daftar" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                <ListBox x:Name="MahasiswaListBox" Height="530" SelectionChanged="MahasiswaListBox_SelectionChanged" />
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Detail" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock x:Name="SelectedStudentInfo" TextWrapping="Wrap" Height="72" />

                <TextBlock Text="NIM" FontSize="12" Foreground="#334155" />
                <TextBox x:Name="AdminStudentNimTextBox" />
                <TextBlock Text="Nama" FontSize="12" Foreground="#334155" />
                <TextBox x:Name="AdminStudentNamaTextBox" />
                <TextBlock Text="Program" FontSize="12" Foreground="#334155" />
                <TextBox x:Name="AdminStudentProgramTextBox" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                  <Button Content="Tambah" Click="AdminAddStudentButton_Click" />
                  <Button Content="Ubah" Click="AdminUpdateStudentButton_Click" />
                  <Button Content="Hapus" Click="AdminDeleteStudentButton_Click" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem Header="Konselor">
          <Grid ColumnDefinitions="2*,3*" Margin="0,14,0,0">
            <Border Background="#FFFFFF" CornerRadius="16" Padding="12" Margin="0,0,12,0">
              <StackPanel Spacing="10">
                <TextBlock Text="Daftar" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                <ListBox x:Name="KonselorListBox" Height="530" SelectionChanged="KonselorListBox_SelectionChanged" />
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Detail" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock x:Name="SelectedCounselorInfo" TextWrapping="Wrap" Height="72" />

                <TextBlock Text="Kode" FontSize="12" Foreground="#334155" />
                <TextBox x:Name="AdminCounselorKodeTextBox" />
                <TextBlock Text="Nama" FontSize="12" Foreground="#334155" />
                <TextBox x:Name="AdminCounselorNamaTextBox" />
                <TextBlock Text="Jabatan" FontSize="12" Foreground="#334155" />
                <TextBox x:Name="AdminCounselorJabatanTextBox" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                  <Button Content="Tambah" Click="AdminAddCounselorButton_Click" />
                  <Button Content="Ubah" Click="AdminUpdateCounselorButton_Click" />
                  <Button Content="Hapus" Click="AdminDeleteCounselorButton_Click" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem Header="Sesi">
          <Grid ColumnDefinitions="2*,3*" Margin="0,14,0,0">
            <Border Background="#FFFFFF" CornerRadius="16" Padding="12" Margin="0,0,12,0">
              <StackPanel Spacing="10">
                <TextBlock Text="Daftar" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                <ListBox x:Name="SesiListBox" Height="530" SelectionChanged="SesiListBox_SelectionChanged" />
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Detail" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock x:Name="SelectedSessionInfo" TextWrapping="Wrap" Height="220" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>
      </TabControl>

      <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#64748B" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
  </Border>
</Window>
