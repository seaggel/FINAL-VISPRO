<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrossPlatformApp.Views.LoginWindow"
        Title="Login"
        Width="360" Height="250"
        WindowStartupLocation="CenterScreen">
  <Border Padding="16">
    <StackPanel Spacing="10">
      <TextBlock Text="Login" FontSize="20" FontWeight="Bold" />
      <TextBox x:Name="UsernameBox" Watermark="Username" />
      <TextBox x:Name="PasswordBox" Watermark="Password" PasswordChar="*" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Masuk" Click="LoginButton_Click" />
        <Button Content="Daftar" Click="RegisterButton_Click" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="Red" />
    </StackPanel>
  </Border>
</Window>
