<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrossPlatformApp.Views.RegistrationWindow"
        Title="Daftar" Width="380" Height="420" WindowStartupLocation="CenterOwner">
  <Border Padding="16">
    <StackPanel Spacing="10">
      <TextBlock Text="Daftar" FontSize="20" FontWeight="Bold" />
      <TextBox x:Name="RegNim" Watermark="NIM" />
      <TextBox x:Name="RegNama" Watermark="Nama" />
      <TextBox x:Name="RegProgramStudi" Watermark="Program Studi" />
      <TextBox x:Name="RegUsername" Watermark="Username" />
      <TextBox x:Name="RegPassword" Watermark="Password" PasswordChar="*" />

      <Button Content="Daftar" Click="RegisterButton_Click" />
      <TextBlock x:Name="RegStatus" Foreground="Red" />
    </StackPanel>
  </Border>
</Window>
